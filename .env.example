# Copy to .env (PowerShell: Copy-Item .env.example .env). Never commit .env.
# --- Database ---
POSTGRES_USER=elimuai
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=elimuai
# Used by the backend inside Docker Compose (host = service name "db")
DATABASE_URL=postgresql+psycopg://elimuai:change-me-local-only@db:5432/elimuai
# --- Backend ---
APP_ENV=development
SECRET_KEY=change-me-generate-a-long-random-value
CORS_ORIGINS=http://localhost:3000
# --- Frontend ---
# Where the Next.js server forwards /api/* (Docker Compose overrides this with http://backend:8000)
BACKEND_URL=http://localhost:8000
# --- Added in later phases (not needed yet) ---
# LLM_PROVIDER=  LLM_API_KEY=      (Phase 0.4 / 5.1)
# SPEECH_PROVIDER=  SPEECH_API_KEY= (Phase 0.3 / 8)
# --- Auth (Phase 2.1) ---
FRONTEND_URL=http://localhost:3000
